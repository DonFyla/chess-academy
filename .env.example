# Chess Academy Environment Variables

# API Configuration (Existing)
NEXT_PUBLIC_API_URL=http://localhost:8000/questionnaire/api

# Supabase Configuration (Scheduling System)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Email Configuration (for booking notifications)
# Get API key from https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# WhatsApp Link for Payments
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.link/uj48gk

# Google Analytics (Optional - for tracking)
# Get your Measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=G-E40RGTR97D

# Redis Configuration (Upstash - for rate limiting)
# Get from https://upstash.com (free tier: 10k requests/day)
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Paystack Payments
# Get keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
