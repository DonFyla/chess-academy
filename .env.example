# Chess Academy Frontend Environment Variables
# Copy this file to .env and update the values

# API Configuration
# Local development (Django backend)
NEXT_PUBLIC_API_URL=http://localhost:8000/questionnaire/api

# Production (Railway backend)
# NEXT_PUBLIC_API_URL=https://mtrain-backend-production.up.railway.app/questionnaire/api

# ==========================================
# SCHEDULING SYSTEM CONFIGURATION
# ==========================================

# Supabase Configuration
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Resend Email API (for booking confirmations)
# Get API key from: https://resend.com
RESEND_API_KEY=re_xxxxxxxx

# WhatsApp Link for Payment
NEXT_PUBLIC_WHATSAPP_LINK=https://wa.link/uj48gk
